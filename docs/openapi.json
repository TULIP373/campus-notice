    "/api/notices/{id}/attachments/{attachmentId}": {
      "get": {
        "summary": "下载当前通知的原始PDF附件",
        "description": "需要notice:read权限；教师还须任教此课程。附件必须属于当前通知。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "attachmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
