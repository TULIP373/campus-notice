  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "required": [
          "username",
          "name"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "writeOnly": true,
            "description": "创建必填至少8字符；更新省略或空白保留；UTF8最多72字节"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER"
            ],
            "default": "STUDENT"
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Notice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "courseId": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "submissionRequirements": {
            "type": "string",
            "nullable": true
          },
          "reportFormat": {
            "type": "string",
            "nullable": true
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "本地日期时间，无时区；空表示待老师通知"
          },
          "source": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "NOTICE",
              "MATERIAL"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NoticeRequest": {
        "type": "object",
        "required": [
          "courseId",
          "title",
          "content",
          "source",
          "type"
        ],
        "properties": {
          "courseId": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "maxLength": 10000
          },
          "submissionRequirements": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          },
          "reportFormat": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "source": {
            "type": "string",
            "maxLength": 255
          },
          "type": {
            "type": "string",
            "enum": [
              "NOTICE",
              "MATERIAL"
            ]
          }
        }
      }
    }
  }
